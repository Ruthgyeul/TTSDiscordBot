{
  "name": "tts-discord-bot",
  "version": "1.0.0",
  "description": "Discord Bot that talks instead of you at voice channel",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "tts",
    "text-to-speech",
    "voice"
  ],
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.2.0",
    "google-tts-api": "^2.0.2",
    "libsodium-wrappers": "^0.7.15",
    "msedge-tts": "^2.0.7",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
