# ============================================================================
#  TTS Discord Bot - 환경 설정
#  이 파일을 복사해 `.env` 로 만들고 값을 채워주세요.  (cp .env.example .env)
#  변동성 있는 값(봇 이름/설명/말투/기본 음성 등)은 전부 여기서 관리합니다.
# ============================================================================

# ─────────────────────────────────────────────────────────────
#  1. 디스코드 인증 (필수)
# ─────────────────────────────────────────────────────────────
DISCORD_TOKEN=여기에_봇_토큰
DISCORD_CLIENT_ID=여기에_애플리케이션_ID
# 특정 서버에만 즉시 명령어를 등록하려면 서버 ID 입력 (비워두면 전역 등록 = 반영에 최대 1시간)
DISCORD_GUILD_ID=

# ─────────────────────────────────────────────────────────────
#  2. 정체성 / 표시 (자유롭게 변경)
# ─────────────────────────────────────────────────────────────
BOT_NAME=하은
BOT_DESCRIPTION=니들 채팅 대신 읽어주는 싸가지 TTS 봇이다. 감사한 줄 알아.
# 상태 메시지 (디스코드 프로필에 표시)
BOT_ACTIVITY=아무한테나 시비걸기
# 활동 타입: Playing | Listening | Watching | Competing | Custom
BOT_ACTIVITY_TYPE=Playing
# 온라인 상태: online | idle | dnd | invisible
BOT_STATUS=online
# 임베드/메시지 강조 색상 (16진수)
BOT_EMBED_COLOR=#C9B7A3

# ─────────────────────────────────────────────────────────────
#  3. TTS 기본 동작  (100% 무료 · Google TTS 기반, API 키 불필요)
# ─────────────────────────────────────────────────────────────
# 기본 목소리 프리셋 키 (src/config/voices.js). 전부 무료·무키.
#   Google(언어): korean, us, japanese, chinese, french, spanish, russian, german
#   Edge(뉴럴 고품질 한국어): 선희, 인준
DEFAULT_VOICE=korean
# 기본 말투 키 = 오디오 이펙트 (src/config/styles.js). FFmpeg 로 음성 조작.
#   normal, chipmunk, deep, robot, echo, hall, telephone, fast, wobble, moan(🔞)
DEFAULT_STYLE=normal
# (고급) TTS 합성 실패 시 폴백 제공자와 언어
FALLBACK_TTS_PROVIDER=google
FALLBACK_LANGUAGE=ko

# ─────────────────────────────────────────────────────────────
#  4. 읽기 규칙 / 필터
# ─────────────────────────────────────────────────────────────
# 한 번에 읽을 최대 글자 수 (넘치면 잘라서 읽음)
MAX_MESSAGE_LENGTH=200
# 길드별 대기열 최대 개수 (초과 시 새 메시지 무시)
QUEUE_MAX=20
# 메시지 읽기 템플릿. {user}=닉네임, {message}=내용
MESSAGE_TEMPLATE={user}님, {message}
# 위 템플릿의 {user} 를 붙일지 여부. false 면 내용만 읽음
READ_USERNAME=false
# 이 접두사로 시작하는 메시지는 읽지 않음 (봇 명령/잡담 제외용, 쉼표로 여러 개)
IGNORE_PREFIXES=!,/,~,.
# 봇/웹훅 메시지도 읽을지 여부
READ_BOTS=false
# URL 을 "링크" 로 축약해 읽을지 여부
STRIP_URLS=true
# 이모지를 제거하고 읽을지 여부
STRIP_EMOJIS=true
# 봇이 읽은 메시지에 이모지 반응을 달지 여부
REACT_ON_READ=true
# 읽음 표시에 사용할 이모지 (유니코드 이모지)
READ_REACTION_EMOJI=✅
# 재생 방식:
#   queue     = 순차 재생(기본). 재생 중이면 끊지 않고 끝난 뒤 이어서 말함. 놀고 있으면 즉시 말함.
#   immediate = 새 메시지가 오면 현재 재생을 끊고 즉시 그 메시지를 말함.
PLAYBACK_MODE=queue

# ─────────────────────────────────────────────────────────────
#  5. 음성 채널 동작
# ─────────────────────────────────────────────────────────────
# 봇을 부른 텍스트 채널의 메시지만 읽음: true | false
#   true  = /join 을 실행한 그 텍스트 채널만
#   false = 서버의 모든 텍스트 채널
BIND_TO_TEXT_CHANNEL=true
# 음성 채널에 사람이 아무도 없으면 자동 퇴장 (초). 0 이면 비활성화
AUTO_LEAVE_SECONDS=120
# 비참여자도 봇을 부르고 TTS 를 쓸 수 있게 할지의 "서버 기본값".
#   false(기본) = 음성 채널에 참여한 사람만 사용
#   true        = 누구나 사용 (채널 지정 소환 포함)
# 서버별로는 관리자가 /config 명령으로 덮어쓸 수 있습니다.
ALLOW_NON_PARTICIPANTS=false
# 재생 후 유휴 상태로 이만큼(밀리초) 지나면 연결 정리 (0=유지)
IDLE_DISCONNECT_MS=0

# ─────────────────────────────────────────────────────────────
#  6. 로깅
# ─────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
